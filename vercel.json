{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{rules/**,static/**,public/**,app/**,scripts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?_path=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?_path=/api"
    },
    {
      "source": "/healthz",
      "destination": "/api/index.py?_path=/healthz"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
