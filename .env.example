# ASHA Sahayak Configuration

# Gemini API (Optional: if unset, app runs in deterministic rules-only fallback mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Emergency / ANM Contact Number (shown on triage result screen)
ANM_PHONE_NUMBER=+919876543210

# Storage: sqlite (default) or firestore
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=asha_sahayak.sqlite

# Optional: Firebase / Firestore credentials JSON string or path
# FIREBASE_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=

# Outbreak Cluster Alert Configuration (thresholds for block-level alerts)
CLUSTER_ALERT_THRESHOLD_COUNT=5
CLUSTER_ALERT_DAYS=3
